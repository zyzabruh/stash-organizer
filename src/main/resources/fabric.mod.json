{
  "schemaVersion": 1,
  "id": "stash-organizer",
  "version": "${version}",
  "name": "Stash Organizer",
  "description": "Opens every nearby storage block and reorganises the stash in place: items are grouped, chests are labelled with item frames and shulker boxes are unpacked, packed or kept shut.",
  "authors": [
    "seasnail"
  ],
  "contact": {
    "sources": "https://github.com/MeteorDevelopment/meteor-addon-template"
  },
  "icon": "assets/stashorganizer/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.example.addon.AddonTemplate"
    ]
  },
  "mixins": [
    "stash-organizer.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "90,200,120",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=21",
    "minecraft": [
      "${mc_version}"
    ],
    "meteor-client": "*"
  }
}
